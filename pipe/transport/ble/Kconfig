menu "AGCORE BLE CONFIG"

config AGCORE_BLE_ENABLE
    bool "Enable AGCORE BLE transport"
    default y
    depends on !APP_NO_BLOBS
    select BT_ENABLED
    select BT_NIMBLE_ENABLED
    select BT_CONTROLLER_ENABLED if SOC_BT_SUPPORTED
    help
        Enable AGCORE BLE transport and select ESP-IDF Bluetooth NimBLE support.

config AGCORE_BLE_ADV_ITVL_MIN_MS
    int "BLE advertising min interval(ms)"
    default 100
    depends on AGCORE_BLE_ENABLE

config AGCORE_BLE_ADV_ITVL_MAX_MS
    int "BLE advertising max interval(ms)"
    default 200
    depends on AGCORE_BLE_ENABLE

config AGCORE_BLE_MESSAGE_MAX_LEN
    int "Maximum reassembled BLE message length"
    range 1 65535
    default 4096
    depends on AGCORE_BLE_ENABLE
    help
        Limit the complete protocol message length, excluding the fragment header.

config AGCORE_BLE_FRAGMENT_TIMEOUT_MS
    int "BLE fragment receive idle timeout(ms)"
    range 100 60000
    default 5000
    depends on AGCORE_BLE_ENABLE
    help
        Release an incomplete message if no valid continuation arrives in time.

endmenu
