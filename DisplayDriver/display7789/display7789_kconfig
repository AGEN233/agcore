menu "ST7789 Configuration"

choice DISPLAY_ST7789_SPI_HOST
    prompt "SPI host"
    default DISPLAY_ST7789_SPI2_HOST

config DISPLAY_ST7789_SPI2_HOST
    bool "SPI2_HOST"

config DISPLAY_ST7789_SPI3_HOST
    bool "SPI3_HOST"
    depends on SOC_SPI_PERIPH_NUM > 2

endchoice

config DISPLAY_ST7789_GPIO_MOSI
    int "MOSI GPIO"
    range -1 48
    default 13

config DISPLAY_ST7789_GPIO_SCLK
    int "SCLK GPIO"
    range -1 48
    default 14

config DISPLAY_ST7789_GPIO_CS
    int "CS GPIO"
    range -1 48
    default 10

config DISPLAY_ST7789_GPIO_DC
    int "DC GPIO"
    range -1 48
    default 11

config DISPLAY_ST7789_GPIO_RST
    int "Reset GPIO (-1 to disable)"
    range -1 48
    default 12

config DISPLAY_ST7789_GPIO_BACKLIGHT
    int "Backlight GPIO (-1 to disable)"
    range -1 48
    default 9

config DISPLAY_ST7789_PIXEL_CLOCK_HZ
    int "Pixel clock (Hz)"
    range 1 80000000
    default 40000000

config DISPLAY_ST7789_WIDTH
    int "Display width"
    range 1 65535
    default 170

config DISPLAY_ST7789_HEIGHT
    int "Display height"
    range 1 65535
    default 320

config DISPLAY_ST7789_X_OFFSET
    int "X offset"
    range 0 65535
    default 35

config DISPLAY_ST7789_Y_OFFSET
    int "Y offset"
    range 0 65535
    default 0

choice DISPLAY_ST7789_BACKLIGHT_ACTIVE_LEVEL
    prompt "Backlight active level"
    default DISPLAY_ST7789_BACKLIGHT_ACTIVE_HIGH

config DISPLAY_ST7789_BACKLIGHT_ACTIVE_HIGH
    bool "Active high"

config DISPLAY_ST7789_BACKLIGHT_ACTIVE_LOW
    bool "Active low"

endchoice


choice DISPLAY_ST7789_COLOR_INVERSION
    prompt "Display color Inversion"
    default DISPLAY_ST7789_NORMAL_COLOR

config DISPLAY_ST7789_NORMAL_COLOR
    bool "Normal"

config DISPLAY_ST7789_INVERT_COLOR
    bool "Inverted"

endchoice


choice DISPLAY_ST7789_COLOR_ORDER
    prompt "Display color order"
    default DISPLAY_ST7789_RGB_ORDER

config DISPLAY_ST7789_RGB_ORDER
    bool "RGB"

config DISPLAY_ST7789_BGR_ORDER
    bool "BGR"

endchoice

endmenu
